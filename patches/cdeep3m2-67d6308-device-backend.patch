+skip_edge=${NCNN_SKIP_EDGE:-}
+if [ -z "$skip_edge" ] ; then
+  if [ "$(basename "$(cd "$deploy_dir" && pwd)")" == "1fm" ] ; then skip_edge=2 ; else skip_edge=0 ; fi
+fi
+
