diff -ruN a/caffepredict.sh b/caffepredict.sh
--- a/caffepredict.sh	2026-11-15 20:52:35.419755248 -0800
+++ b/caffepredict.sh	2026-11-15 20:53:03.591705610 -0800
@@ -12,6 +12,8 @@
 fi
 
 gpu="all"
+device="auto"
+backend="caffe"
 
 function usage()
 {
@@ -39,12 +41,19 @@
   -h, --help           show this help message and exit
   --gpu                Which GPU to use, can be a number ie 0 or 1 or
                        all to use all GPUs (default $gpu)
+  --backend            caffe (default) or ncnn. ncnn needs the converted
+                       model in <model dir>/ncnn/ and supports --device
+                       cpu or vulkan (any Vulkan GPU).
+  --device             auto, cpu, gpu (caffe/CUDA) or vulkan (ncnn). auto: with caffe an NVIDIA GPU
+                       if nvidia-smi reports one, with ncnn the first discrete Vulkan GPU;
+                       otherwise the CPU.
+                       (default $device)
 
     " 1>&2;
    exit 1;
 }
 
-TEMP=$(getopt -o h --long "help,gpu:" -n "$0" -- "$@")
+TEMP=$(getopt -o h --long "help,gpu:,device:,backend:" -n "$0" -- "$@")
 eval set -- "$TEMP"
 
 while true ; do
@@ -52,6 +61,8 @@
         -h ) usage ;;
         --help ) usage ;;
         --gpu ) gpu=$2 ; shift 2 ;;
+        --device ) device=$2 ; shift 2 ;;
+        --backend ) backend=$2 ; shift 2 ;;
         --) shift ; break ;;
     esac
 done
@@ -91,9 +102,55 @@
   fatal_error "$out_dir" "ERROR unable to create $log_dir" 3
 fi
 
-gpucount=$(nvidia-smi -L | wc -l)
-if [ "$gpucount" -eq 0 ] ; then
-  fatal_error "$out_dir" "ERROR unable to get count of GPU(s). Is nvidia-smi working?" 4
+# ncnn: --gpu <n> selects the Vulkan device; auto takes the first discrete Vulkan GPU, else the CPU
+ncnn_gpu_index=0
+if [[ "$gpu" =~ ^[0-9]+$ ]] ; then
+  ncnn_gpu_index=$gpu
+fi
+if [ "$backend" == "ncnn" ] && [ "$device" == "auto" ] ; then
+  pick=$(python3 "${script_dir}/ncnn_predict.py" --pick-device 2>/dev/null)
+  if [[ "$pick" == vulkan* ]] ; then
+    device="vulkan"
+    ncnn_gpu_index=${pick#vulkan }
+  else
+    device="cpu"
+  fi
+fi
+
+if [ "$device" == "auto" ] ; then
+  if command -v nvidia-smi > /dev/null 2>&1 && [ "$(nvidia-smi -L 2>/dev/null | wc -l)" -gt 0 ] ; then
+    device="gpu"
+  else
+    device="cpu"
+  fi
+fi
+
+if [ "$backend" == "ncnn" ] ; then
+  if [ "$device" != "cpu" ] && [ "$device" != "vulkan" ] ; then
+    fatal_error "$out_dir" "ERROR ncnn backend needs --device cpu or vulkan" 4
+  fi
+  if [ "$device" == "vulkan" ] ; then
+    echo "Running prediction with ncnn on vulkan (GPU $ncnn_gpu_index)"
+  else
+    echo "Running prediction with ncnn on $device"
+  fi
+  gpu="0"
+  gpucount=1
+elif [ "$device" == "vulkan" ] ; then
+  fatal_error "$out_dir" "ERROR --device vulkan requires --backend ncnn" 4
+elif [ "$device" == "cpu" ] ; then
+  # caffe tools run in CPU mode when --gpu is negative. One job at a time,
+  # BLAS uses all cores.
+  echo "Running prediction on CPU"
+  gpu="-1"
+  gpucount=1
+elif [ "$device" == "gpu" ] ; then
+  gpucount=$(nvidia-smi -L | wc -l)
+  if [ "$gpucount" -eq 0 ] ; then
+    fatal_error "$out_dir" "ERROR unable to get count of GPU(s). Is nvidia-smi working?" 4
+  fi
+else
+  fatal_error "$out_dir" "ERROR --device must be auto, cpu or gpu" 4
 fi
 
 (( maxgpuindex=$gpucount-1 ))
@@ -105,7 +162,7 @@
   else
     echo " Using only GPU $gpu"
   fi
-else
+elif [ "$device" == "gpu" ] ; then
   echo "Single GPU detected."
 fi
 
@@ -116,6 +173,11 @@
   (( gpucount=1 ))
 fi
 
+# merge_16_probs.py discards the predictions for the 2+2 z-padding positions of every model, so the
+# ncnn backend does not predict them (the padded slices are still read as input context by 3fm/5fm).
+# NCNN_SKIP_EDGE=0 turns this off.
+skip_edge=${NCNN_SKIP_EDGE:-2}
+
 theargs=""
 parallel_job_file="$out_dir/parallel.jobs"
 for input_file in $(find "${in_dir}" -name "*.h5" -type f | sort -V) ;
@@ -176,7 +238,11 @@
     ;;
     # The gpu number makes the final command string
     5)
-    echo "GLOG_logtostderr=\"${job_array[0]}\" /usr/bin/time -p $CAFFE_PATH/.build_release/tools/predict_seg_new.bin --model=${job_array[1]}/deploy.prototxt --weights=${job_array[2]} --data=${job_array[3]} --predict=${job_array[4]}/test.h5 --shift_axis=2 --shift_stride=1 --gpu=$line >> \"$out_log\" 2>&1" >> "$cmdlets"
+    if [ "$backend" == "ncnn" ] ; then
+      echo "/usr/bin/time -p python3 ${script_dir}/ncnn_predict.py --model-dir ${job_array[1]}/ncnn --data ${job_array[3]} --predict ${job_array[4]}/test.h5 --device $device --gpu-index $ncnn_gpu_index ${NCNN_PRECISION:+--precision $NCNN_PRECISION} --skip-edge $skip_edge >> \"$out_log\" 2>&1" >> "$cmdlets"
+    else
+      echo "GLOG_logtostderr=\"${job_array[0]}\" /usr/bin/time -p $CAFFE_PATH/.build_release/tools/predict_seg_new.bin --model=${job_array[1]}/deploy.prototxt --weights=${job_array[2]} --data=${job_array[3]} --predict=${job_array[4]}/test.h5 --shift_axis=2 --shift_stride=1 --gpu=$line >> \"$out_log\" 2>&1" >> "$cmdlets"
+    fi
     ;;
     *)
     echo "I should never be here in default"
